@model List<Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý danh mục</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm danh mục</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Chưa có danh mục nào.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tên danh mục</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Xóa danh mục này?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
