@model List<MenuCategoryViewModel>
@using System.Globalization
@{
    ViewData["Title"] = "Thực đơn";
    var vnCulture = CultureInfo.GetCultureInfo("vi-VN"); // 25000 -> "25.000"
}

<h1 class="mb-4">Thực đơn</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Hiện chưa có món nào.</div>
}

@foreach (var category in Model)
{
    <section class="mb-5">
        <h3 class="mb-3">@category.CategoryName</h3>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var product in category.Products)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(product.ImageUrl ?? "/images/no-image.svg")"
                             class="card-img-top menu-card-img" alt="@product.Name" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                <p class="card-text text-muted small">@product.Description</p>
                            }
                            <p class="card-text fw-bold text-danger mt-auto mb-0">@product.Price.ToString("N0", vnCulture) đ</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}
